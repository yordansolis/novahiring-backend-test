# --- Infraestructura local (docker compose) ---
DATABASE_URL=postgresql+asyncpg://nova:nova_dev@localhost:5433/nova_hiring
REDIS_URL=redis://localhost:6380

# --- Claves de proveedores de IA ---
# Necesarias solo para evaluacion de CVs, entrevista y reportes.
# Las migraciones, el seed y los tests unitarios funcionan sin ellas.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth ---
# Vacias = auth admin/candidato desactivada (solo desarrollo).
# En produccion: openssl rand -hex 32
API_KEY_ADMIN=
API_KEY_CANDIDATES=

# --- App ---
DEBUG=true
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# --- Email (Brevo SMTP) ---
# Vacío = las invitaciones NO se envían. El admin ve el aviso en Proceso
# y puede copiar las credenciales desde Candidatos.
# En Brevo: Settings → SMTP & API → pestaña SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NovaHiring
